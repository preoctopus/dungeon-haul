{
  "name": "@dhaul/server",
  "version": "0.1.0",
  "private": true,
  "description": "Dungeon Haul server — lobby REST (Hono) + Colyseus HaulSession rooms + authoritative movement sim. P2: netcode slice on box_level.",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --enable-source-maps dist/main.js",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.44",
    "@colyseus/ws-transport": "^0.17.13",
    "@dhaul/levels": "workspace:*",
    "@dhaul/protocol": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "express": "^5.2.1",
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@types/node": "^24.0.0"
  }
}
